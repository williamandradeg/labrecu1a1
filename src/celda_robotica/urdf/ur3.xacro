<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur3">
<xacro:include filename="/opt/ros/jazzy/share/ur_description/urdf/ur_macro.xacro"/>
<xacro:include filename="/opt/ros/jazzy/share/ur_simulation_gz/urdf/ur_gz.ros2_control.xacro"/>
<link name="world"/>
<xacro:ur_robot name="ur3" tf_prefix="ur3_" parent="world" joint_limits_parameters_file="/opt/ros/jazzy/share/ur_description/config/ur3/joint_limits.yaml" kinematics_parameters_file="/opt/ros/jazzy/share/ur_description/config/ur3/default_kinematics.yaml" physical_parameters_file="/opt/ros/jazzy/share/ur_description/config/ur3/physical_parameters.yaml" visual_parameters_file="/opt/ros/jazzy/share/ur_description/config/ur3/visual_parameters.yaml" force_abs_paths="true">
<origin xyz="-1.25 -0.38 0.8" rpy="0 0 0"/>
</xacro:ur_robot>
<link name="ur3_vacuum">
<inertial><origin xyz="0 0 .05"/><mass value=".12"/><inertia ixx=".0001" iyy=".0001" izz=".0001" ixy="0" ixz="0" iyz="0"/></inertial>
<visual><origin xyz="0 0 .025"/><geometry><cylinder radius=".022" length=".05"/></geometry><material name="metal"><color rgba=".25 .3 .35 1"/></material></visual>
<visual><origin xyz="0 0 .06"/><geometry><cylinder radius=".012" length=".04"/></geometry><material name="stem"><color rgba=".7 .75 .8 1"/></material></visual>
<visual><origin xyz="0 0 .085"/><geometry><cylinder radius=".029" length=".018"/></geometry><material name="rubber"><color rgba=".08 .1 .12 1"/></material></visual>
<visual><origin xyz="0 0 .101"/><geometry><cylinder radius=".039" length=".018"/></geometry><material name="rubber"/></visual>
</link>
<joint name="ur3_vacuum_joint" type="fixed"><parent link="ur3_tool0"/><child link="ur3_vacuum"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
<gazebo reference="ur3_vacuum_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
<gazebo><plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"><parameters>/home/william/lrrecupera/src/celda_robotica/config/ur3_controllers.yaml</parameters><ros><namespace>/ur3</namespace></ros></plugin>
<plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
<parent_link>ur3_vacuum</parent_link><child_model>caja</child_model><child_link>body</child_link>
<attach_topic>/celda/ur3/attach</attach_topic><detach_topic>/celda/ur3/detach</detach_topic><output_topic>/celda/ur3/attached</output_topic><initially_detached>true</initially_detached>
</plugin></gazebo>
<xacro:ur_ros2_control name="ur3" tf_prefix="ur3_" initial_positions="${dict(shoulder_pan_joint=1.2419915757895157,shoulder_lift_joint=-1.6806565100515245,elbow_joint=1.0953058234620658,wrist_1_joint=-0.9854456404541946,wrist_2_joint=-1.5707963265850058,wrist_3_joint=-0.32880475121051067)}"/>
</robot>